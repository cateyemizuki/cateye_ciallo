{
  "manifest_version": 2,
  "id": "github.cateye.ciallo",
  "version": "1.0.0",
  "name": "Ciallo～(∠・ω< )⌒★",
  "description": "让麦麦可爱地打个招呼，发送 Ciallo～(∠・ω< )⌒★。提供 LLM 工具 send_ciallo（可传入 message_id 对指定消息引用回复）、命令 /ciallo（任何人可用，引用某条消息发送命令时改为对那条消息回复），以及可选的关键词自动回复（配置启用后，命中关键词的消息会自动收到一条 Ciallo 引用回复）。另支持语音输出模式（默认关闭）：开启后所有 Ciallo 一律以语音直接发出，不再引用回复；语音文件需手动放置到插件数据目录。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_ciallo",
    "homepage": "https://github.com/cateyemizuki/cateye_ciallo",
    "documentation": "https://github.com/cateyemizuki/cateye_ciallo/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_ciallo/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.hybrid",
    "chat.get_all_streams",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "sparkles"
    }
  }
}
