# 运行时配置由 Runner 生成，禁止提交
/config.toml

__pycache__/
*.py[cod]

# 离线自测代码（本地开发用，不随插件上传，见插件中心发布规范）
/tests/

# Issue 提交文档（本地使用，不随插件上传）
/ISSUE_SUBMISSION.md

# ---- 以下规则合并自 MaiBot插件开发文档v1.3.0/.gitignore 模板（UPLOAD_AGENT.md 等流程文档与运行期产物不进仓库）----

# 流程 / 指导文档（禁止进仓库）
UPLOAD_AGENT.md

# 运行期生成的配置与数据（宿主会在插件目录生成）
/config_back/
/data/
*.log

# 宿主安装回执与更新备份（发布安装模式写入，勿提交）
.maibot-release.json
.update_backups/

# 构建产物 / 虚拟环境
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 散置测试 / 冒烟代码（发布内容不含测试，见 UPLOAD_AGENT.md §2.3）
test_*.py
*_test.py
smoke_test*.py

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
